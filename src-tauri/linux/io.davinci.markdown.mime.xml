<?xml version="1.0" encoding="UTF-8"?>
<!--
  Shared MIME-info registration.

  `text/markdown`, `application/json`, `text/csv`, `text/plain` and
  `application/xml` are already defined by the shared-mime-info database on
  modern distributions, so this file only adds the globs that associate the
  extensions this application handles with those types. It is installed into
  /usr/share/mime/packages/ and picked up by `update-mime-database`.

  Packaging note: the Tauri Debian/RPM bundler writes an equivalent
  registration from `bundle.fileAssociations` in tauri.conf.json. This file is
  the explicit, reviewable copy used when packing by hand or when a distribution
  needs the association to be declared as a package file.
-->
<mime-info xmlns="http://www.freedesktop.org/standards/shared-mime-info">
  <mime-type type="text/markdown">
    <comment>Markdown document</comment>
    <comment xml:lang="ru">Документ Markdown</comment>
    <glob pattern="*.md"/>
    <glob pattern="*.markdown"/>
    <glob pattern="*.mdown"/>
    <glob pattern="*.mkdn"/>
    <glob pattern="*.mkd"/>
    <glob pattern="*.mdx"/>
    <glob pattern="*.mdtxt"/>
    <glob pattern="*.mdtext"/>
  </mime-type>

  <mime-type type="application/json">
    <comment>JSON document</comment>
    <comment xml:lang="ru">Документ JSON</comment>
    <glob pattern="*.json"/>
    <glob pattern="*.geojson"/>
    <glob pattern="*.webmanifest"/>
  </mime-type>

  <mime-type type="text/csv">
    <comment>CSV table</comment>
    <comment xml:lang="ru">Таблица CSV</comment>
    <glob pattern="*.csv"/>
    <glob pattern="*.tsv"/>
  </mime-type>

  <mime-type type="text/x-log">
    <comment>Log file</comment>
    <comment xml:lang="ru">Журнал событий</comment>
    <glob pattern="*.log"/>
    <glob pattern="*.ndjson"/>
  </mime-type>

  <mime-type type="application/xml">
    <comment>XML document</comment>
    <comment xml:lang="ru">Документ XML</comment>
    <glob pattern="*.xml"/>
    <glob pattern="*.xsd"/>
    <glob pattern="*.xsl"/>
    <glob pattern="*.xslt"/>
    <glob pattern="*.rss"/>
    <glob pattern="*.atom"/>
  </mime-type>
</mime-info>

{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DaVinci Markdown Editor",
  "version": "0.3.0",
  "identifier": "io.davinci.markdown",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "DaVinci Markdown Editor",
        "width": 1360,
        "height": 880,
        "minWidth": 680,
        "minHeight": 420,
        "resizable": true,
        "center": true,
        "visible": false,
        "focus": true,
        "decorations": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; base-uri 'self'; form-action 'none'; object-src 'none'; frame-src 'none'; worker-src 'self' blob:; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: mdasset: http://mdasset.localhost; font-src 'self' data:; media-src 'self' mdasset: http://mdasset.localhost; connect-src 'self' ipc: http://ipc.localhost",
      "dangerousDisableAssetCspModification": [
        "style-src"
      ],
      "capabilities": [
        "default"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "DeveloperTool",
    "publisher": "DaVinci Cyber Engineering",
    "homepage": "https://www.davinci-cyber-engineering.uz/",
    "shortDescription": "Markdown, JSON, CSV, LOG and XML editor with Mermaid diagrams and live preview",
    "longDescription": "DaVinci Markdown Editor is a fast, natively integrated editor for Markdown, JSON, CSV, LOG and XML documents on Windows, Linux and macOS.\n\nMarkdown renders GitHub Flavored Markdown, Mermaid diagrams with the DaVinci palette, syntax-highlighted code blocks and KaTeX math with a live preview, and exports to PDF and self-contained HTML. JSON and XML open as a tree with lossless source editing, CSV as a sortable table with real CSV parsing, and LOG as an event list with levels, filters and stack traces. Every format keeps its source as the single source of truth, so saving never rewrites the file.\n\nThe application registers itself as a handler for the five formats and ships a dedicated icon for each of them.\n\nDaVinci Cyber Engineering\nSecure - Analyze - Engineer - Build\n\nWeb: https://www.davinci-cyber-engineering.uz/\nEmail: info@davinci-cyber-engineering.uz\nSupport the project (USDT TRC20): TAnJB15jGXVtfKkwgs2pz5NFN5fN22ha41",
    "copyright": "Copyright (C) 2026 DaVinci Cyber Engineering",
    "licenseFile": "../LICENSE",
    "resources": {
      "icons/filetypes/": "icons/filetypes/"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": [
          "md",
          "markdown",
          "mdown",
          "mkdn",
          "mkd",
          "mdx",
          "mdtxt",
          "mdtext"
        ],
        "name": "DaVinci.Markdown.Document",
        "description": "Markdown document",
        "role": "Editor",
        "mimeType": "text/markdown"
      },
      {
        "ext": [
          "json",
          "geojson",
          "webmanifest"
        ],
        "name": "DaVinci.Json.Document",
        "description": "JSON document",
        "role": "Editor",
        "mimeType": "application/json"
      },
      {
        "ext": [
          "csv",
          "tsv"
        ],
        "name": "DaVinci.Csv.Document",
        "description": "CSV table",
        "role": "Editor",
        "mimeType": "text/csv"
      },
      {
        "ext": [
          "log",
          "ndjson"
        ],
        "name": "DaVinci.Log.Document",
        "description": "Log file",
        "role": "Editor",
        "mimeType": "text/plain"
      },
      {
        "ext": [
          "xml",
          "xsd",
          "xsl",
          "xslt",
          "rss",
          "atom"
        ],
        "name": "DaVinci.Xml.Document",
        "description": "XML document",
        "role": "Editor",
        "mimeType": "application/xml"
      }
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "compression": "lzma",
        "displayLanguageSelector": false,
        "languages": [
          "English",
          "Russian"
        ],
        "installerHooks": "nsis/filetypes.nsh"
      },
      "wix": {
        "language": [
          "en-US"
        ]
      }
    },
    "linux": {
      "deb": {
        "files": {
          "/usr/share/mime/packages/io.davinci.markdown.xml": "linux/io.davinci.markdown.mime.xml"
        },
        "desktopTemplate": "linux/desktop-entry.hbs"
      },
      "rpm": {
        "files": {
          "/usr/share/mime/packages/io.davinci.markdown.xml": "linux/io.davinci.markdown.mime.xml"
        },
        "desktopTemplate": "linux/desktop-entry.hbs"
      },
      "appimage": {
        "bundleMediaFramework": false
      }
    },
    "macOS": {
      "minimumSystemVersion": "10.15",
      "hardenedRuntime": true,
      "entitlements": "macos/entitlements.plist",
      "dmg": {
        "windowSize": {
          "width": 660,
          "height": 400
        },
        "appPosition": {
          "x": 180,
          "y": 170
        },
        "applicationFolderPosition": {
          "x": 480,
          "y": 170
        }
      }
    }
  },
  "plugins": {}
}

# Dependencies
node_modules/
bower_components/
jspm_packages/

# Frontend build output
dist/
dist-ssr/
*.local

# Rust / Tauri build output
src-tauri/target/
src-tauri/gen/schemas/
src-tauri/gen/apple/
# The generated Android project is kept in the repository: it carries the
# Kotlin plugin that reads `content://` documents and prints, and the intent
# filters that make the application open `.md` files. Its own .gitignore files
# already leave out the build output, the machine-specific settings and
# everything the Tauri CLI regenerates.

# Editor and OS noise
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db
*.swp

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Test output
coverage/
test-results/
playwright-report/
.vitest/

# Local environment
.env
.env.local
.env.*.local

# Local tooling artefacts (editor/agent configuration, not project config)
.mimosa/
.smoke/
.zcodeignore
